{
  "name": "echoclass",
  "version": "3.0.0-beta.25",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "node scripts/start-production.mjs",
    "test": "npm run build --silent && node --test tests/*.test.mjs dist/tests/*.test.js",
    "test:integration": "npm run build --silent && node --test dist/tests/integration/*.test.js",
    "test:python": "node scripts/test-python.mjs",
    "scientific:demo": "npm run build --silent && node scripts/scientific-demo.mjs",
    "project:trace": "npm run build --silent && node scripts/project-trace.mjs",
    "eval:grounded": "npm run build --silent && node scripts/grounded-eval.mjs",
    "smoke-test": "npm run build --silent && node scripts/smoke-test.mjs",
    "security-check": "npm run build --silent && node scripts/security-check.mjs && node --test dist/tests/integration/*.test.js",
    "backup": "node scripts/backup-db.mjs",
    "restore": "node scripts/restore-db.mjs",
    "prepare-release": "node scripts/prepare-release.mjs",
    "eval:retrieval": "npm run build --silent && node scripts/retrieval-eval.mjs",
    "scientific:study": "npm run build --silent && node scripts/method-study.mjs",
    "scientific:design": "npm run build --silent && node scripts/followup-design.mjs",
    "publication:check": "node scripts/publication-check.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "csv-stringify": "6.8.3"
  }
}
